# Лични данни — остават само на този компютър, никога в GitHub:
# журнал на разговорите и доклади от тест режима
logs/
# памет на разговора, бележки, напомняния, поуки, портфейл
memory/
# личните настройки на прозореца
user_settings.json
# ТАЕН ключ за връзката с Google
google_settings.json
# ключът за търговия в Hyperliquid (криптиран) и лимитите
trading_settings.json
trading_settings.json.tmp
# личните документи, от които Орион отговаря
knowledge/

# Временни и генерирани файлове:
__pycache__/
*.pyc
*.log
# архив на версиите на уменията (за „върни предишната версия“)
skills/.history/
# временни файлове на тест режима
skills/_selftest_*
# пакетите за изграждане на прозореца (React) — npm install ги сваля отново
web/node_modules/
# работните скици от обсъжданията (визуални варианти)
.superpowers/
